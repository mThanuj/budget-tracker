{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.vercel)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm drizzle-kit migrate:*)",
      "Bash(pnpm drizzle-kit push:*)",
      "Bash(vercel:*)",
      "Bash(pnpm test:e2e:live:*)",
      "Bash(pnpm ai:eval:*)",
      "Bash(pnpm ai:chat-eval:*)",
      "Bash(pnpm ai:insights-eval:*)"
    ]
  }
}
