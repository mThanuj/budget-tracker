{
  "name": "budget-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm db:check && pnpm docs:check && pnpm test",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:integration": "vitest run tests/integration",
    "test:component": "vitest run tests/component",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "test:e2e:live": "LIVE_AI=1 playwright test --grep @live-ai",
    "ai:eval": "node --import tsx --env-file-if-exists=.env.local scripts/ai-eval.ts",
    "ai:chat-eval": "node --import tsx --env-file-if-exists=.env.local scripts/ai-chat-eval.ts",
    "ai:insights-eval": "node --import tsx --env-file-if-exists=.env.local scripts/ai-insights-eval.ts",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.77",
    "@base-ui/react": "1.9.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@sentry/nextjs": "11.9.0",
    "ai": "7.0.152",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "next-devtools-mcp": "0.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.20.0"
}
