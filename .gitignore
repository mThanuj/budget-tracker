# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template is safe to commit
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/.tour/

# Test run logs (written by tests/support/vitest-log-reporter.ts and tests/e2e/support/ordered-list.ts)
test-*.log

# Git worktrees that coding agents create for isolated work
/.claude/worktrees/
