# Copy to .env.local and fill in. Never commit real values.

# Display name (used across the site and the legal pages)
NEXT_PUBLIC_APP_NAME="ClearPaisa"

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret for the job that records recurring entries (`openssl rand -hex 32`; at
# least 24 characters, or the job stays off). The scheduler calls
# GET /api/cron/recurring with "Authorization: Bearer <secret>": Vercel's cron
# does this daily by itself; on your own server, schedule it hourly.
CRON_SECRET=""

# --- AI (optional: the app works fully without it) -------------------------
# Providers are tried in this order. Any provider without an API key is skipped.
# All three are chosen because they don't train on your users' data by default
# (OpenRouter is restricted to providers that don't collect data via LLM_OPENROUTER_BODY).
LLM_CHAIN_FREE="groq,cerebras,openrouter"
# Pro users try this chain first, e.g. "groq_paid,groq,cerebras,openrouter" with a
# paid Groq key as LLM_GROQ_PAID_*. Leave empty and Pro uses the free chain.
LLM_CHAIN_PRO=""

# Groq: https://console.groq.com/keys
LLM_GROQ_BASE_URL="https://api.groq.com/openai/v1"
LLM_GROQ_API_KEY=""
LLM_GROQ_MODEL="openai/gpt-oss-120b"
LLM_GROQ_MODEL_FAST="openai/gpt-oss-20b"
LLM_GROQ_STRUCTURED="true"
LLM_GROQ_OPTIONS='{"reasoningEffort":"low"}'

# Cerebras: https://cloud.cerebras.ai (API keys)
LLM_CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
LLM_CEREBRAS_API_KEY=""
LLM_CEREBRAS_MODEL="gpt-oss-120b"
LLM_CEREBRAS_MODEL_FAST="gpt-oss-120b"
LLM_CEREBRAS_STRUCTURED="true"
LLM_CEREBRAS_OPTIONS='{"reasoningEffort":"low"}'

# OpenRouter: https://openrouter.ai/settings/keys (free models only)
LLM_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_OPENROUTER_API_KEY=""
LLM_OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
LLM_OPENROUTER_MODEL_FAST="nvidia/nemotron-3-super-120b-a12b:free"
LLM_OPENROUTER_STRUCTURED="true"
LLM_OPENROUTER_BODY='{"provider":{"data_collection":"deny"}}'

# AI requests per day for everyone together on the free chain, to stay within
# the free providers' daily quotas. Per-user limits come from src/config/plans.ts.
AI_GLOBAL_DAILY_LIMIT=1500

# --- Payments (off by default) ----------------------------------------------
# "true" switches on the Free/Pro plans, the Billing page, pricing and upsells.
# Off: everyone is on Free and nothing about payments shows. Needs a redeploy.
BILLING_ENABLED="false"
# Razorpay keys and plans (only used while BILLING_ENABLED is "true").
# Razorpay, test mode first: Dashboard → switch to Test Mode → API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Two plans in Subscriptions → Plans: ₹79 monthly and ₹799 yearly (ids start with plan_).
# Prices shown in the app live in src/config/plans.ts; keep them the same.
RAZORPAY_PLAN_MONTHLY=""
RAZORPAY_PLAN_YEARLY=""
# Webhooks → https://<your-domain>/api/webhooks/razorpay with the subscription.*
# events, and this as its secret. Not needed on localhost (the app checks with Razorpay directly).
RAZORPAY_WEBHOOK_SECRET=""

# --- Running the site ---------------------------------------------------------
# Emails that can open /admin (comma-separated, must match your Google sign-in).
ADMIN_EMAILS=""
# Shown on /privacy, /terms, /refund and /contact (Razorpay checks these pages).
LEGAL_NAME=""          # your full legal name, or your business's registered name
SUPPORT_EMAIL=""
SUPPORT_PHONE=""       # optional
BUSINESS_ADDRESS=""    # the address you operate from
LEGAL_CITY=""          # courts for disputes, e.g. "Hyderabad"

# Next.js telemetry off
NEXT_TELEMETRY_DISABLED=1
