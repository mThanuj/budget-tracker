# Copy to .env.local and fill in. Never commit real values.

# Display name (placeholder until the product is named)
NEXT_PUBLIC_APP_NAME="Budget Tracker"

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret for the hourly job that records recurring entries (`openssl rand -hex 32`).
# The server's scheduler calls GET /api/cron/recurring with "Authorization: Bearer <secret>".
CRON_SECRET=""

# Next.js telemetry off
NEXT_TELEMETRY_DISABLED=1
