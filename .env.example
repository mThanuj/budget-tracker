# Copy to .env.local and fill in. Never commit real values.

# Display name (placeholder until the product is named)
NEXT_PUBLIC_APP_NAME="Budget Tracker"

# Neon Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (Google Cloud console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret for the hourly job that records recurring entries (`openssl rand -hex 32`).
# The server's scheduler calls GET /api/cron/recurring with "Authorization: Bearer <secret>".
CRON_SECRET=""

# --- AI (optional: the app works fully without it) -------------------------
# Providers are tried in this order. Any provider without an API key is skipped.
# All three are chosen because they don't train on your users' data by default
# (OpenRouter is restricted to providers that don't collect data via LLM_OPENROUTER_BODY).
LLM_CHAIN_FREE="groq,cerebras,openrouter"

# Groq: https://console.groq.com/keys
LLM_GROQ_BASE_URL="https://api.groq.com/openai/v1"
LLM_GROQ_API_KEY=""
LLM_GROQ_MODEL="openai/gpt-oss-120b"
LLM_GROQ_MODEL_FAST="openai/gpt-oss-20b"
LLM_GROQ_STRUCTURED="true"
LLM_GROQ_OPTIONS='{"reasoningEffort":"low"}'

# Cerebras: https://cloud.cerebras.ai (API keys)
LLM_CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
LLM_CEREBRAS_API_KEY=""
LLM_CEREBRAS_MODEL="gpt-oss-120b"
LLM_CEREBRAS_MODEL_FAST="gpt-oss-120b"
LLM_CEREBRAS_STRUCTURED="true"
LLM_CEREBRAS_OPTIONS='{"reasoningEffort":"low"}'

# OpenRouter: https://openrouter.ai/settings/keys (free models only)
LLM_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LLM_OPENROUTER_API_KEY=""
LLM_OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
LLM_OPENROUTER_MODEL_FAST="nvidia/nemotron-3-super-120b-a12b:free"
LLM_OPENROUTER_STRUCTURED="true"
LLM_OPENROUTER_BODY='{"provider":{"data_collection":"deny"}}'

# Requests per user per day (entry filling + category suggestions), and for
# everyone together, to stay within the free providers' daily quotas.
AI_USER_DAILY_LIMIT=50
AI_GLOBAL_DAILY_LIMIT=1500

# Next.js telemetry off
NEXT_TELEMETRY_DISABLED=1
