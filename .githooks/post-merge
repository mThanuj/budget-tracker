#!/bin/sh
# After a pull that changed dependencies: a dev server left running across a
# dependency change served blank pages once (implementation-notes.md).
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qx 'pnpm-lock.yaml'; then
  echo "pnpm-lock.yaml changed: run pnpm install, then restart pnpm dev." >&2
fi
exit 0
